{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "webpackConfigFactory": "webpack-hmr",
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "**/*",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  }
}
